# =============================================
# CONFIGURAZIONE TELEGRAM USERBOT
# Copia questo file in .env e compila i valori
# =============================================

# --- Credenziali Telegram API ---
# Ottieni API_ID e API_HASH da https://my.telegram.org/apps
API_ID=
API_HASH=

# Stringa di sessione Telethon (generata offline con gen_session.py)
SESSION_STRING=

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Supabase (profilo utente persistente) ---
# Dalla dashboard Supabase → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=                          # service_role key (NON la anon key)

# --- Upstash Redis (history chat + cache) ---
# Dalla dashboard Upstash → il tuo database → Connect → .env
UPSTASH_REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# TTL cache profilo in Redis (secondi, default 1 ora)
PROFILE_CACHE_TTL=3600

# --- Modalità test ---
# Se true, risponde solo agli utenti in TEST_USERS
TEST_MODE_ENABLED=false
TEST_USERS=                            # es: 123456789,987654321

# --- Parametri buffer ---
BUFFER_DELAY=90                        # secondi attesa dopo ultimo messaggio
MAX_MESSAGES=7                         # max messaggi nel buffer prima del flush

# --- LLM ---
MAX_HISTORY_TURNS=20                   # turni di storia passati al Main Agent

# --- Logging ---
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
